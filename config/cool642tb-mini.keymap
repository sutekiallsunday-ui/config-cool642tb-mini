#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

//mod-tap (home row mods) ローマ字入力高速時の誤爆対策

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

//layer-tap (親指キー Space/Tab/Enter/BS/[) 同じ趣旨の誤爆対策（強化版）

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <200>;
};

// NOTE: cool642tb-mini には `trackball_listener` / `msc_input_listener` ノードが
// 定義されていないため、LiNEA40 にあったリスナー上書きは削除しました。
// もしご利用のシールド側に該当ノード（例: &xiao_pd_pim447 等）がある場合は、
// その正しいラベル名に書き換えて再追加してください。

/ {
    combos {
        compatible = "zmk,combos";

        // cool642tb-mini レイアウトに合わせて key-positions を再マップ
        // Row1: 0-9 / Row2: 10-21 / Row3: 22-33 / Row4: 34-42
        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <38 39>; // SPACE + TAB（親指）
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <18 19>; // J + K
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        macro01: macro01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp LS(Q) &kp LS(V) &kp LS(I) &kp LS(A)>;
            label = "MACRO01";
        };

        macro02: macro02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(C) &kp LS(S) &kp LS(M) &kp LS(S)>;
            label = "MACRO02";
        };

        macro03: macro03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp E &kp D &kp LS(T) &kp E &kp C &kp H &kp KP_NUMBER_2>;
            label = "MACRO03";
        };

        macro04: macro04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp LS(S) &kp SPACE &kp LS(C) &kp O &kp N &kp N &kp E &kp C &kp T>;
            label = "MACRO04";
        };

        macro05: macro05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp LS(H) &kp LS(D) &kp SPACE &kp LS(E) &kp C &kp H &kp O &kp SPACE &kp LS(L) &kp A &kp B &kp DOT>;
            label = "MACRO05";
        };

        macro06: macro06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMBER_1 &kp O &kp N &kp KP_NUMBER_1>;
            label = "MACRO06";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_ALT Q      &kp W   &kp E               &kp R   &kp T                                                  &kp Y            &kp U      &kp I      &kp O    &kp P
&mt LEFT_SHIFT A    &kp S   &kp D               &kp F   &kp G  &trans                          &trans           &kp H            &kp J      &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&mt LEFT_CONTROL Z  &kp X   &kp C               &kp V   &kp B  &trans                          &trans           &kp N            &kp M      &kp COMMA  &kp DOT  &mt RIGHT_CONTROL QMARK
&mt LCTRL ESC       &kp LEFT_WIN  &mt LEFT_ALT GRAVE  &trans  &lt 4 SPACE  &lt 2 TAB    &lt 3 ENTER  &lt 4 BACKSPACE                                              &lt 5 LEFT_BRACKET
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                              &trans
            >;
        };

        //2

        MARK {
            bindings = <
&trans     &kp LG(LS(S))  &kp LS(LC(R))  &kp LC(R)      &trans                                  &kp MINUS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LS(SEMI)
&kp LC(A)  &kp LS(S)      &kp LC(D)      &kp LC(LS(G))  &kp LC(G)  &trans          &trans       &kp DOT    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0
&kp LC(Z)  &kp LC(X)      &kp LC(C)      &kp LC(V)      &kp LC(B)  &trans          &trans       &kp SLASH  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(SQT)
&trans     &trans         &trans         &trans         &trans     &trans          &trans       &kp EQUAL                                                    &kp AT
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        CURSOR {
            bindings = <
&macro04  &macro05       &macro06          &trans      &trans                                     &trans    &kp LG(LEFT_ARROW)  &kp UP_ARROW    &kp LG(RIGHT_ARROW)  &trans
&macro01  &macro02       &macro03          &trans      &trans      &trans          &trans         &kp HOME  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END
&trans    &kp LESS_THAN  &kp GREATER_THAN  &kp LS(N8)  &kp LS(N9)  &trans          &trans         &trans    &trans              &trans          &trans               &trans
&trans    &trans         &trans            &trans      &trans      &trans          &kp ENTER      &trans                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //4

        FUNCTION {
            bindings = <
&trans            &trans            &trans            &trans            &trans                                            &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))
&kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)  &trans          &trans          &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))
&trans            &trans            &trans            &trans            &trans            &trans          &trans          &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))
&trans            &trans            &trans            &trans            &trans            &trans          &trans          &trans                                          &trans
            >;

            sensor-bindings = <&re_kp INTERNATIONAL_5 LANGUAGE_1>;
        };

        //5

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                    &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &bootloader     &studio_unlock    &trans                                                     &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
