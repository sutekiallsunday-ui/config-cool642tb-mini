#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

// home-row mods (&mt LSHIFT A, &mt LALT Q, &mt LCTRL Z 等) が
// 高速日本語入力中に HOLD と誤判定され、Shift / Alt / Ctrl が
// 保持されたまま次の文字が IME に渡ってローマ字入力モードに
// 切り替わる現象を防ぐための設定:
//   - tap-preferred: tapping-term を超えるまで HOLD にしない
//   - quick-tap-ms : 直前タップ後の同キー押下を強制タップ
//   - require-prior-idle-ms: 直前 250ms 以内にキー入力があれば強制タップ

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <250>;
};

// layer-tap (&lt 3 SPACE, &lt 2 TAB, &lt 1 ENTER 等) が
// 高速日本語入力中に HOLD と誤判定され、瞬間的に別レイヤー
// (SCROLL の Alt+数字、NUM の Ctrl+英字 など) が出力されて
// IME がローマ字入力に切り替わる現象を防ぐ。
// 過去にこの値を 200〜250 に上げると症状が消えた実績あり。

/ {
    combos {
        compatible = "zmk,combos";

        // J + K → DELETE
        // 直前にキー入力があった場合は発火させない (誤発火防止)

        lang {
            bindings = <&kp DELETE>;
            key-positions = <19 18>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // TAB + ENTER → LANG1 (英数 / Romaji direct input)
        // 日本語入力中の TAB / ENTER 連打で誤発火し
        // IME がローマ字直接入力に切り替わる現象を防ぐため、
        // timeout を短くし、直前 200ms キー入力が無い場合のみ発火させる

        hennkan {
            bindings = <&kp LANG1>;
            key-positions = <39 40>;
            timeout-ms = <35>;
            require-prior-idle-ms = <200>;
        };

        // SPACE + BACKSPACE → LANGUAGE_2 (かな)
        // 同様に誤発火防止のためガード

        Lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <38 41>;
            timeout-ms = <35>;
            require-prior-idle-ms = <200>;
        };

        // L + MINUS → BROWSER レイヤー (mo 7)
        // 右手ホームポジションで触れる位置のため、
        // タイピング中の誤発火防止に require-prior-idle-ms を追加

        scroll_combo {
            timeout-ms = <100>;
            key-positions = <20 21>;
            bindings = <&mo 7>;
            slow-release;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    macros {
        macro01: macro01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp LS(Q) &kp LS(V) &kp LS(I) &kp LS(A)>;
            label = "MACRO01";
        };

        macro02: macro02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(C) &kp LS(S) &kp LS(M) &kp LS(S)>;
            label = "MACRO02";
        };

        macro03: macro03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp E &kp D &kp LS(T) &kp E &kp C &kp H>;
            label = "MACRO03";
        };

        macro04: macro04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp LS(S) &kp SPACE &kp LS(C) &kp O &kp N &kp N &kp E &kp C &kp T>;
            label = "MACRO04";
        };

        macro05: macro05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp LS(H) &kp LS(D) &kp SPACE &kp LS(E) &kp C &kp H &kp O &kp SPACE &kp LS(L) &kp A &kp B &kp PERIOD>;
            label = "MACRO05";
        };

        macro06: macro06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMBER_1 &kp O &kp N &kp KP_NUMBER_1>;
            label = "MACRO06";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_ALT Q      &kp W         &kp E        &kp R         &kp T                                    &kp Y          &kp U  &kp I      &kp O    &lt 8 P
&mt LEFT_SHIFT A    &kp S         &kp D        &lt 3 F       &kp G        &kp LC(Y)      &kp H        &kp H          &kp J  &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&mt LEFT_CONTROL Z  &kp X         &kp C        &kp V         &kp B        &kp LC(Z)      &kp ESC      &kp N          &kp M  &kp COMMA  &kp DOT  &mt LCTRL QUESTION
&kp ESCAPE          &kp LEFT_GUI  &kp LG(DOT)  &kp LEFT_ALT  &lt 3 SPACE  &lt 2 TAB      &lt 1 ENTER  &kp BACKSPACE                             &lt 6 SLASH
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW {
            bindings = <
&macro04  &macro05       &macro06          &trans      &trans                                     &kp LG(LC(LEFT_ARROW))  &kp LG(LEFT_ARROW)  &kp UP_ARROW    &kp LG(RIGHT)    &kp LG(LC(RIGHT))
&macro01  &macro02       &macro03          &trans      &trans          &trans             &trans  &kp HOME                &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT        &kp END
&trans    &kp LESS_THAN  &kp GREATER_THAN  &kp LS(N8)  &kp LS(N9)      &trans             &trans  &trans                  &kp C_VOLUME_DOWN   &kp C_MUTE      &kp C_VOLUME_UP  &trans
&trans    &trans         &trans            &trans      &kp LG(LC(F4))  &kp LG(LC(D))      &trans  &trans                                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        NUM {
            bindings = <
&trans      &kp LS(LG(S))  &kp LS(LC(R))  &kp LC(R)      &trans                             &kp MINUS   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp RS(SEMICOLON)
&kp LC(A)   &kp LC(S)      &kp LC(D)      &kp LS(LC(G))  &kp LC(G)  &trans      &kp LS(GT)  &kp PERIOD  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0
&kp LC(Z)   &kp LC(X)      &kp LC(C)      &kp LC(V)      &kp LC(B)  &trans      &trans      &kp SLASH   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(SINGLE_QUOTE)
&bt BT_CLR  &trans         &trans         &trans         &trans     &trans      &trans      &trans                                                         &kp QUESTION
            >;
        };

        SCROLL {
            bindings = <
&trans            &trans            &trans            &trans            &trans                          &trans  &trans  &trans  &trans  &trans
&kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(N5)  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans            &trans            &trans            &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans            &trans            &trans            &trans      &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4     &kp N5                              &kp N6     &kp N7    &kp N8    &kp N9        &kp N0
&kp PLUS  &kp MINUS  &kp ASTRK  &kp SLASH  &kp EQUAL  &kp UNDER      &kp HOME  &kp ENTER  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5     &trans         &trans    &kp F6     &kp F7    &kp F8    &kp F9        &kp F10
&trans    &trans     &trans     &trans     &trans     &trans         &trans    &trans                                       &kp F11
            >;
        };

        BT {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR_ALL
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans                                                  &trans
            >;
        };

        TB_SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BROWSER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
